# ============================================================
# Ada Platform - Production Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# For Azure VM deployment, populate from Azure Key Vault.

# --- Server ---
HOST=0.0.0.0
PORT=8000
DEBUG=false

# --- Azure OpenAI (required for real extraction) ---
# Get these from Azure Portal > Your OpenAI Resource > Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://altabot-ai.openai.azure.com/
AZURE_OPENAI_KEY="678SYJiCX9zolD9xotwquEUm6hqLyLlfsrCrpZVscml7ovyrIss9JQQJ99BHACYeBjFXJ3w3AAABACOGZj31"
AZURE_DEPLOYMENT=gpt-4o
API_VERSION="2024-12-01-preview"

# --- Storage Backend ---
# --- Storage Backend ---
STORAGE_TYPE=mongo

# --- MongoDB (local Docker) ---
MONGO_CONNECTION_STRING=mongodb://mongo:27017/ada-db?ssl=false
MONGO_DB_NAME=ada-db

# --- Authentication ---
JWT_SECRET=CHANGE-ME-TO-A-RANDOM-SECRET-IN-PRODUCTION
JWT_EXPIRY_SECONDS=86400
DEFAULT_ADMIN_PASSWORD=admin@123$$
