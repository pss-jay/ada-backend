# Azure OpenAI Configuration (REQUIRED for real document extraction)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Storage Backend: "file" (JSON files) or "mongo" (Azure Cosmos DB / MongoDB)
STORAGE_TYPE=file

# MongoDB / Cosmos DB (required if STORAGE_TYPE=mongo)
MONGO_CONNECTION_STRING=
MONGO_DB_NAME=ada_platform

# Authentication
JWT_SECRET=change-me-to-a-random-secret
JWT_EXPIRY_SECONDS=86400
DEFAULT_ADMIN_PASSWORD=admin123
